{
  "name": "kos-jeans",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-supabase.mjs",
    "db:test:hosted": "node --env-file=.env.local scripts/test-supabase-hosted.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "catalog:seed": "node --env-file=.env.local scripts/catalog-dev-fixtures.mjs",
    "catalog:test:hosted": "node --env-file=.env.local scripts/test-catalog-hosted.mjs",
    "product:seed": "node --env-file=.env.local scripts/product-dev-fixtures.mjs",
    "product:test:hosted": "node --env-file=.env.local scripts/test-product-hosted.mjs",
    "admin:test:hosted": "node --env-file=.env.local scripts/test-admin-hosted.mjs",
    "categories:test:hosted": "node --env-file=.env.local scripts/test-categories-hosted.mjs",
    "products:test:hosted": "node --env-file=.env.local scripts/test-admin-products-hosted.mjs",
    "cart:test:hosted": "node --env-file=.env.local scripts/test-cart-hosted.mjs",
    "checkout:test:hosted": "node --env-file=.env.local scripts/test-checkout-hosted.mjs",
    "checkout:cleanup": "node --env-file=.env.local scripts/cleanup-checkout-tests.mjs",
    "orders:test:hosted": "node --env-file=.env.local scripts/test-admin-orders-hosted.mjs",
    "orders:cleanup:ui": "node --env-file=.env.local scripts/cleanup-admin-order-ui.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
