# Template only: copy to .env.local. Never commit real values.
# Production canonical site URL; leave empty to use the existing Vercel URL.
NEXT_PUBLIC_SITE_URL=

# Dedicated DEVELOPMENT project only until hosted tests pass.
# Supabase dashboard: Connect / API Keys. Use the publishable key (sb_publishable_...).
# Both browser and server clients use RLS and the visitor's session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No service-role/secret key is needed for this foundation.
# Never put a database password, sb_secret_ key or service_role JWT in NEXT_PUBLIC_*.
